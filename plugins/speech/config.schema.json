{
    "schema": {
        "speech": {
            "type": "object",
            "title": "{{title}}",
            "properties": {
                "device": {
                    "type": "string",
                    "title": "{{dev name}}",
                    "required": true,
                    "default": "default",
                    "enum": [
                        "default"
                    ]
                },
                "keyFilename": {
                    "type": "string",
                    "title": "{{keyfile}}",
                    "required": true,
                    "default": "keyfile.json"
                },
                "hotwords": {
                    "type": "array",
                    "title": "{{hotwords}}",
                    "required": true,
                    "items": {
                        "title": "keyword {{idx}}",
                        "type": "object",
                        "properties": {
                            "keyword": {
                                "type": "string",
                                "title": "{{Keyword Name}}",
                                "required": true
                            },
                            "model": {
                                "type": "string",
                                "title": "{{Model Filename}}",
                                "required": true
                            }
                        }
                    }
                },
                "sensitivity": {
                    "type": "number",
                    "title": "{{mic sensitivity}}",
                    "default": 0.5,
                    "minimum": 0,
                    "maximum": 1,
                    "required": true
                },
                "audioGain": {
                    "type": "number",
                    "title": "{{audio gain}}",
                    "default": 1.0,
                    "minimum": 0.1,
                    "maximum": 2.0,
                    "required": true
                },
                "hotwordCooldownMs": {
                    "type": "integer",
                    "title": "{{hotword cooldown}}",
                    "default": 4000,
                    "minimum": 0,
                    "required": true
                },
                "emptyFinalBackoffMs": {
                    "type": "integer",
                    "title": "{{empty final backoff}}",
                    "default": 30000,
                    "minimum": 0,
                    "required": true
                },
                "resource": {
                    "type": "string",
                    "title": "{{resource file}}",
                    "default": "",
                    "required": false
                }
            }
        }
    },
    "form": [
        {
            "type": "fieldset",
            "title": "{{form title}}",
            "expandable": false,
            "order": -75,
            "items": [
                {
                    "type": "help",
                    "helpvalue": "{{speech dev help}}"
                },
                {
                    "key":"speech.device",
                    "titleMap": {
                        "default":"Default Device"
                    }
                },
                "speech.keyFilename",
                {
                    "type": "tabarray",
                    "title": "{{hotwords}}",
                    "items": [
                        {
                            "type": "section",
                            "legend": "{{value}}",
                            "items": [
                                {
                                    "key": "speech.hotwords[].keyword",
                                    "valueInLegend": true,
                                    "title": "{{Keyword Name}}"
                                },
                                "speech.hotwords[].model"
                            ]
                        }
                    ]
                },
                {
                    "type": "range",
                    "step": 0.1,
                    "key": "speech.sensitivity",
                    "description":"{{sensitivity help}}"
                },
                {
                    "type": "range",
                    "step": 0.1,
                    "key": "speech.audioGain",
                    "description":"{{audio gain help}}"
                },
                {
                    "key": "speech.hotwordCooldownMs",
                    "description":"{{hotword cooldown help}}"
                },
                {
                    "key": "speech.emptyFinalBackoffMs",
                    "description":"{{empty final backoff help}}"
                },
                {
                    "key": "speech.resource",
                    "description":"{{resource file help}}"
                }
            ]
        }
    ],
    "value": {
        "speech": {
            "device": "default",
            "keyFilename": "keyfile.json",
            "hotwords": [
                {
                    "keyword": "smart mirror",
                    "model": "smart_mirror.umdl"
                }
            ],
            "sensitivity": 0.5,
            "audioGain": 1.0,
            "hotwordCooldownMs": 4000,
            "emptyFinalBackoffMs": 30000,
            "resource": ""
        }
    }
}
